# Use these only in your local terminal or deployment environment. Never commit
# a real API secret and never expose it through VITE_ variables.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional. Set to true only when you deliberately want to replace files that
# already use the same Cloudinary public ID.
CLOUDINARY_OVERWRITE=false
